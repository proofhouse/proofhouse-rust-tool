{
  "language": "en",
  "ignorePaths": [
    "**/*.log",
    ".claude/worktrees/**/*",
    ".vale/**/*",
    "Cargo.lock",
    "LICENSE",
    "LICENSES/**/*",
    "node_modules/**/*",
    "target/**/*",
    "tmp/**/*"
  ],
  "dictionaryDefinitions": [
    {
      "name": "proofhouse",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["proofhouse", "rust", "rust-crates"]
}
